{
  "name": "@fuel-pos/cloud-api",
  "version": "0.1.0",
  "private": true,
  "description": "ระบบหลังบ้านบนคลาวด์ (SaaS) — ปิดกะ สต็อกน้ำมัน Dashboard เจ้าของ ตั้งค่าสาขา",
  "type": "module",
  "main": "./dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "tsc -p tsconfig.json && node --watch dist/src/main.js",
    "migrate": "node dist/scripts/migrate.js",
    "tenant:create": "node dist/scripts/create-tenant.js",
    "seed:demo": "node dist/scripts/seed-demo.js",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.3",
    "@nestjs/core": "^12.6.3",
    "@nestjs/platform-fastify": "^12.6.3",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "typescript": "^5.7.2"
  }
}
