{
  "name": "@fuel-pos/pump-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./profiles/*": "./profiles/*"
  },
  "files": ["dist", "profiles"],
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "clean": "rimraf dist dist-test tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@fuel-pos/shared": "*",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
